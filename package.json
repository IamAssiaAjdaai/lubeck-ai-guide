{
  "name": "lubeck-ai-guide",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run dev:infra",
    "dev": "next dev",
    "dev:infra": "node scripts/ensure-local-infrastructure.mjs",
    "build": "next build",
    "vercel-build": "npm run db:migrate && next build",
    "prestart": "npm run dev:infra",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audio:generate": "tsx scripts/generate-landmark-audio.ts",
    "audio:coverage": "tsx scripts/generate-landmark-audio.ts --coverage",
    "db:generate": "drizzle-kit generate",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed-database.ts",
    "db:verify": "tsx scripts/verify-database.ts",
    "cms:import-lubeck": "tsx scripts/import-lubeck-cms.ts",
    "cms:test:integration": "tsx scripts/run-cms-integration-tests.ts",
    "media:test:integration": "tsx scripts/run-media-integration-tests.ts",
    "commerce:test:integration": "tsx scripts/run-commerce-integration-tests.ts",
    "media:backfill-audio-duration": "node --conditions=react-server --import tsx scripts/backfill-audio-duration.ts",
    "admin:create-super": "tsx scripts/create-super-admin.ts",
    "knowledge:manage": "node --conditions=react-server --import tsx scripts/manage-verified-knowledge.ts",
    "knowledge:test:integration": "node --import tsx scripts/run-knowledge-integration-tests.ts",
    "commerce:provision-lubeck-pass": "tsx scripts/provision-lubeck-city-pass.ts",
    "mobile:start": "npm --prefix mobile run start",
    "mobile:test": "npm --prefix mobile run test:run",
    "mobile:lint": "npm --prefix mobile run lint",
    "mobile:typecheck": "npm --prefix mobile run typecheck",
    "mobile:config": "npm --prefix mobile run config:validate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@better-auth/expo": "^1.7.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "better-auth": "^1.7.2",
    "drizzle-orm": "^0.45.2",
    "groq-sdk": "^1.6.0",
    "lucide-react": "^1.39.0",
    "maplibre-gl": "^6.7.0",
    "music-metadata": "^11.15.0",
    "next": "16.3.4",
    "openai": "^7.9.0",
    "pg": "^8.23.0",
    "posthog-js": "^1.424.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@google-cloud/text-to-speech": "^7.0.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "edge-tts.js": "^2.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
