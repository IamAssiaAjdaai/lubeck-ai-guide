{
  "name": "lubeck-ai-guide",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run dev:infra",
    "dev": "next dev",
    "dev:infra": "node scripts/ensure-local-infrastructure.mjs",
    "build": "next build",
    "vercel-build": "npm run db:migrate && next build",
    "prestart": "npm run dev:infra",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audio:generate": "tsx scripts/generate-landmark-audio.ts",
    "audio:coverage": "tsx scripts/generate-landmark-audio.ts --coverage",
    "db:generate": "drizzle-kit generate",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed-database.ts",
    "db:verify": "tsx scripts/verify-database.ts",
    "cms:import-lubeck": "tsx scripts/import-lubeck-cms.ts",
    "cms:import-city": "node --conditions=react-server --import tsx scripts/import-city-cms.ts",
    "city:import": "node --conditions=react-server --import tsx scripts/import-city-cms.ts",
    "content:readiness": "node --conditions=react-server --import tsx scripts/report-city-readiness.ts",
    "performance:measure": "tsx scripts/measure-public-performance.ts",
    "cms:test:integration": "tsx scripts/run-cms-integration-tests.ts",
    "content:test:integration": "tsx scripts/run-city-content-integration-tests.ts",
    "media:test:integration": "tsx scripts/run-media-integration-tests.ts",
    "commerce:test:integration": "tsx scripts/run-commerce-integration-tests.ts",
    "lifecycle:test:integration": "tsx scripts/run-lifecycle-integration-tests.ts",
    "media:backfill-audio-duration": "node --conditions=react-server --import tsx scripts/backfill-audio-duration.ts",
    "media:migrate-storage": "node --conditions=react-server --import tsx scripts/migrate-media-object-storage.ts",
    "admin:create-super": "tsx scripts/create-super-admin.ts",
    "knowledge:manage": "node --conditions=react-server --import tsx scripts/manage-verified-knowledge.ts",
    "knowledge:test:integration": "node --import tsx scripts/run-knowledge-integration-tests.ts",
    "commerce:provision-lubeck-pass": "tsx scripts/provision-lubeck-city-pass.ts",
    "mobile:start": "npm --prefix mobile run start",
    "mobile:test": "npm --prefix mobile run test:run",
    "mobile:lint": "npm --prefix mobile run lint",
    "mobile:typecheck": "npm --prefix mobile run typecheck",
    "mobile:config": "npm --prefix mobile run config:validate",
    "i18n:check": "node packages/i18n/scripts/check.mjs",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy",
    "deploy:vinext:dry-run": "vinext-cloudflare deploy --dry-run",
    "rate-limit:test:integration": "node --conditions=react-server --import tsx scripts/run-rate-limit-integration-tests.ts"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@better-auth/expo": "^1.7.7",
    "@citywalk/i18n": "file:packages/i18n",
    "@citywalk/traveler-core": "file:packages/traveler-core",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "11.1.0",
    "groq-sdk": "^1.6.0",
    "lucide-react": "^1.39.0",
    "maplibre-gl": "^6.7.0",
    "music-metadata": "^11.15.0",
    "next": "16.3.8",
    "openai": "^7.9.0",
    "pg": "^8.23.0",
    "posthog-js": "^1.424.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "stripe": "^22.4.0",
    "jose": "^6.2.12",
    "@vinext/cloudflare": "1.0.1",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "1.0.1"
  },
  "devDependencies": {
    "@google-cloud/text-to-speech": "^7.0.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "edge-tts.js": "^2.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11",
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-52b0dc0e9",
    "@vitejs/plugin-rsc": "^0.5.35",
    "cf": "^1.0.0-beta.12",
    "oxc-transform-react": "^0.145.0",
    "postcss": "^8.5.28",
    "vite": "^8.3.0",
    "vite-css-modules": "^1.16.0"
  },
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module"
}
