# Independent local QA only. Never use CITYWALK's DATABASE_URL.
MARKETING_DATABASE_URL=postgresql://marketing_qa:local_marketing_qa_only@127.0.0.1:55498/marketing_mvp_local
MARKETING_AUTH_SECRET=replace-with-a-random-value-of-at-least-32-characters
MARKETING_ORIGIN=http://127.0.0.1:3108
MARKETING_API_PORT=3109
MARKETING_MAIL_DIRECTORY=.qa-mail
MARKETING_DEMO_MODE=false

# Leave disabled until the owner explicitly authorizes real provider spend.
MARKETING_AI_ENABLED=false
MARKETING_OPENAI_MODEL=
# Operator-reviewed conservative EUR rates for the selected model; no assumed pricing.
MARKETING_INPUT_EUR_PER_MILLION=
MARKETING_OUTPUT_EUR_PER_MILLION=
# OPENAI_API_KEY is kept in the separate ignored, approved local file. Never use VITE_ or NEXT_PUBLIC_.
