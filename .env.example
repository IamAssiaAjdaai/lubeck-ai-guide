# PostHog browser configuration
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Local development database from docker-compose.yml (server-only)
DATABASE_URL=postgresql://citywalk:citywalk@localhost:5432/citywalk
# Better Auth server-only settings (generate a unique 32+ character secret)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
CITYWALK_CONTENT_SOURCE=code
# Server-only S3-compatible media storage (use separate Preview/production buckets)
CITYWALK_MEDIA_STORAGE=s3
CITYWALK_MEDIA_S3_ENDPOINT=
CITYWALK_MEDIA_S3_REGION=
CITYWALK_MEDIA_S3_BUCKET=
CITYWALK_MEDIA_S3_ACCESS_KEY_ID=
CITYWALK_MEDIA_S3_SECRET_ACCESS_KEY=
CITYWALK_MEDIA_PUBLIC_BASE_URL=
# Local CLI bootstrap only; do not commit real values or pass passwords as args
CITYWALK_ADMIN_EMAIL=
CITYWALK_ADMIN_NAME=
CITYWALK_ADMIN_PASSWORD=
