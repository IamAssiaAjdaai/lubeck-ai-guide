# PostHog browser configuration
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Local development database from docker-compose.yml (server-only)
DATABASE_URL=postgresql://citywalk:citywalk@localhost:5432/citywalk
# Better Auth server-only settings (generate a unique 32+ character secret)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# database is the production default. code explicitly uses curated files; auto is development-only.
CITYWALK_CONTENT_SOURCE=database
# Server-only S3-compatible media storage (use separate Preview/production buckets)
CITYWALK_MEDIA_STORAGE=s3
CITYWALK_MEDIA_S3_ENDPOINT=
CITYWALK_MEDIA_S3_REGION=
CITYWALK_MEDIA_S3_BUCKET=
CITYWALK_MEDIA_S3_ACCESS_KEY_ID=
CITYWALK_MEDIA_S3_SECRET_ACCESS_KEY=
# One-off object-storage migration profiles; never reuse these as runtime config
CITYWALK_MEDIA_MIGRATION_SOURCE_S3_ENDPOINT=
CITYWALK_MEDIA_MIGRATION_SOURCE_S3_REGION=
CITYWALK_MEDIA_MIGRATION_SOURCE_S3_BUCKET=
CITYWALK_MEDIA_MIGRATION_SOURCE_S3_ACCESS_KEY_ID=
CITYWALK_MEDIA_MIGRATION_SOURCE_S3_SECRET_ACCESS_KEY=
CITYWALK_MEDIA_MIGRATION_DESTINATION_S3_ENDPOINT=
CITYWALK_MEDIA_MIGRATION_DESTINATION_S3_REGION=auto
CITYWALK_MEDIA_MIGRATION_DESTINATION_S3_BUCKET=
CITYWALK_MEDIA_MIGRATION_DESTINATION_S3_ACCESS_KEY_ID=
CITYWALK_MEDIA_MIGRATION_DESTINATION_S3_SECRET_ACCESS_KEY=
# Local CLI bootstrap only; do not commit real values or pass passwords as args
CITYWALK_ADMIN_EMAIL=
CITYWALK_ADMIN_NAME=
CITYWALK_ADMIN_PASSWORD=

# Optional: Ask CITYWALK (server-only; discovery/planning does not require these)
GROQ_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: paid checkout and verified webhooks (server-only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional public map style URL (compiled into browser bundle; never use a secret key)
NEXT_PUBLIC_CITY_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Vercel supplies VERCEL_URL and VERCEL_BRANCH_URL automatically.
# In Preview, omit BETTER_AUTH_URL to allow both exact Vercel hosts;
# do not set a production URL or wildcard trusted origin for Preview.
# GROQ model is configured in src/app/api/guide/route.ts (no model env override).
# Stripe uses hosted checkout: no browser/public Stripe key is required.
# Product/price mappings live in PostgreSQL; use isolated Stripe TEST resources.
# Media is proxied through same-origin API routes; no public bucket URL is needed.
