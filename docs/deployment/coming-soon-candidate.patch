@@ -0,0 +1,35 @@
+.page { color: #123852; background: #f6f8f7; font-family: var(--font-geist-sans), sans-serif; line-height: 1.6; }
+.page * { box-sizing: border-box; }
+.page a { color: inherit; text-underline-offset: .3em; }
+.page a:focus-visible { outline: 3px solid #008477; outline-offset: 5px; }
+.skip { position: absolute; left: 1rem; top: -8rem; z-index: 20; background: white; padding: 1rem; }
+.skip:focus { top: 1rem; }
+.header, .main, .footer { max-width: 80rem; margin-inline: auto; padding-inline: clamp(1.25rem, 5vw, 5rem); }
+.header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 1.5rem; }
+.header a { display: inline-flex; align-items: center; min-height: 44px; font-size: .875rem; }
+.logo { display: inline-flex; align-items: center; gap: .5rem; }
+.mark { width: 2rem; height: 2.8rem; }
+.wordmark { font-weight: 800; letter-spacing: -.04em; font-size: 1.2rem; }
+.hero { display: grid; align-items: center; gap: 2rem; padding-block: 3rem 4rem; }
+.eyebrow { font-size: .75rem; font-weight: 650; letter-spacing: .1em; text-transform: uppercase; }
+.copy h1 { font-size: clamp(3.6rem, 7.5vw, 6.6rem); line-height: 1.04; letter-spacing: -.065em; font-weight: 600; margin: 1.5rem 0; }
+.copy h1 span { color: #007b72; }
+.intro { max-width: 30rem; font-size: 1.125rem; color: #425b67; }
+.platforms { display: flex; gap: .75rem; margin-block: 2rem; }
+.platforms span { border: 1px solid #b9cacb; border-radius: 2rem; padding: .55rem 1.4rem; font-size: .875rem; }
+.date { font-size: .875rem; }
+.date time { display: block; font-size: 1.25rem; font-weight: 650; }
+.note { max-width: 28rem; color: #526772; font-size: .8rem; }
+.art { position: relative; min-height: 23rem; display: grid; place-items: center; overflow: hidden; border-radius: 50% 50% 1rem 1rem; background: #e3edeb; }
+.heroMark { height: 18rem; width: 13rem; position: relative; }
+.orbit { position: absolute; width: 27rem; height: 27rem; border: 1px solid #b0c9c3; border-radius: 50%; transform: translate(5rem, 4rem); box-shadow: 0 0 0 3rem #e3edeb, 0 0 0 calc(3rem + 1px) #c5d9d2; }
+.city { position: absolute; bottom: 1.5rem; left: 1.5rem; font-size: .7rem; letter-spacing: .12em; }
+.city strong { font-size: 1rem; letter-spacing: 0; }
+.details { display: grid; gap: 2rem; border-top: 1px solid #cddad7; padding-block: 3rem 4rem; }
+.details h2 { font-size: 1.5rem; line-height: 1.25; font-weight: 550; letter-spacing: -.03em; }
+.details p:last-child { max-width: 31rem; color: #425b67; font-size: .95rem; }
+.footer { border-top: 1px solid #cddad7; padding-block: 2rem 8rem; display: flex; flex-wrap: wrap; gap: 2rem; justify-content: space-between; font-size: .8rem; }
+.footer div { display: grid; gap: .5rem; }
+.footer nav { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; align-content: start; }
+.footer a { display: inline-flex; align-items: center; min-height: 44px; }
+@media (min-width: 760px) { .hero { grid-template-columns: 1.15fr 1fr; gap: 4rem; padding-block: 4rem 5rem; } .art { min-height: 34rem; } .heroMark { height: 25rem; width: 18rem; } .details { grid-template-columns: 1fr 1fr; gap: 5rem; } }
